# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Turso Database
TURSO_DATABASE_URL="libsql://your-db-url.turso.io"
TURSO_AUTH_TOKEN="your-auth-token"

# Admin wipe protection: required by POST /api/v1/admin/wipe via the x-admin-secret header.
# Pick a long random value and keep it private — anyone with it can erase all data.
ADMIN_SECRET="change-me-to-a-long-random-secret"

# Port for the Express server (Railway/Heroku inject PORT automatically)
PORT=3000
